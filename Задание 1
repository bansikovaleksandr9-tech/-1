import math

def arg(a, b, c):
    print(f"Решение уравнения: {a}x² + {b}x + {c} = 0")

    if a == 0:
        if b == 0:
            if c == 0:
                print("Бесконечное множество решений")
            else:
                print("Нет решений")
        else:
            x = -c / b
            print(f"Линейное уравнение. Корень: x = {x}")
        return

    D = b * b - 4 * a * c
    print(f"Дискриминант D = {D}")

    if D < 0:
        print("Нет действительных корней")
    elif D == 0:
        x = -b / (2.0 * a)
        print(f"Один корень: x = {x}")
    else:
        x1 = (-b + math.sqrt(D)) / (2.0 * a)
        x2 = (-b - math.sqrt(D)) / (2.0 * a)
        print(f"x₁ = {x1}")
        print(f"x₂ = {x2}")

a = 0
b = -6
c = 8

arg(a, b, c)
