import math

def arg(a, b, c):
    print(f"Решение уравнения: {a}x² + {b}x + {c} = 0")

    D = b * b - 4 * a * c
    print(f"Дискриминант D = {b}² - 4·{a}·{c} = {D}")

    if D < 0:
        print("Нет действительных корней")
    elif D == 0:
        x = -b / (2.0 * a)
        print(f"Один корень: x = {x}")
    else:
        x1 = (-b + math.sqrt(D)) / (2.0 * a)
        x2 = (-b - math.sqrt(D)) / (2.0 * a)
        
        print("Корни уравнения:")
        print(f"x₁ = {x1}")
        print(f"x₂ = {x2}")
        
        print("Проверка по теореме Виета:")
        print(f"x₁ + x₂ = {x1 + x2} (должно быть -b/a = {-b / a})")
        print(f"x₁ · x₂ = {x1 * x2} (должно быть c/a = {c / a})")
        
        if abs((x1 + x2) - (-b / a)) < 1e-10 and abs((x1 * x2) - (c / a)) < 1e-10:
            print("Проверка пройдена!")
        else:
            print("Проверка не пройдена!")

a = 1
b = -6
c = 8

arg(a, b, c)
